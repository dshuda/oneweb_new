# ==================== DATABASE ====================
MYSQL_ROOT_PASSWORD=SecureRootPassword2024!
MYSQL_DATABASE=oneweb
MYSQL_USER=oneweb
MYSQL_PASSWORD=SecureDatabasePassword2024!

# ==================== JWT CONFIG ====================
JWT_SECRET=YourSuperSecretKeyThatIsAtLeast32CharactersLongForProduction!
JWT_ISSUER=OneWeb
JWT_AUDIENCE=OneWebClients
JWT_EXPIRY_MINUTES=1440

# ==================== REDIS ====================
REDIS_PASSWORD=SecureRedisPassword2024!

# ==================== SSL CERTIFICATES (for production) ====================
SSL_CERT_PATH=/etc/nginx/ssl/certificate.crt
SSL_KEY_PATH=/etc/nginx/ssl/private.key

# ==================== ENVIRONMENT ====================
ASPNETCORE_ENVIRONMENT=Production
TZ=Asia/Dhaka