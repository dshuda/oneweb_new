# Base URL of the OneWeb API (src/OneWeb.Api).
#
# Baked into the client bundle at BUILD time, so it must be set before
# `next build` — changing it afterwards has no effect.
# Leave it empty to fall back to the page's own origin, which is what you want
# when the API is served from the same hostname behind a reverse proxy.
#
#   local API      : http://localhost:5102
#   shared server  : http://104.248.232.169:5102
#   production     : https://api.onetapservice.com
NEXT_PUBLIC_API_URL=http://104.248.232.169:5102
