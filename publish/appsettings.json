{
    "ConnectionStrings": {
        "Default": "Host=localhost; port=5433;Database=oneweb;Username=postgres;Password=postgres"
    },
    "Redis": {
        "ConnectionString": "localhost:6379"
    },

  // Secrets are supplied by the environment (BKash__Username, BKash__AppSecret,
  // …) — see .env.prod. They were previously committed here in clear text and
  // must be treated as compromised until rotated with the provider.
  "BKash": {
    "BaseUrl": "https://tokenized.sandbox.bka.sh/v2",
    "Username": "",
    "Password": "",
    "AppKey": "",
    "AppSecret": "",
    "TokenExpirySeconds": 3600
  },
    // Storefront origin. Also seeds the CORS and payment-return allow-lists.
    "FrontendUrl": "",

    "Jwt": {
        // MUST come from Jwt__SecretKey in the environment; an empty value here
        // makes a misconfigured deploy fail loudly instead of shipping a
        // well-known key that anyone could forge tokens with.
        "SecretKey": "",
        "Issuer": "OneWeb",
        "Audience": "OneWebUsers",
        "AccessTokenExpiryMinutes": 60,
        "RefreshTokenExpiryDays": 7
    },
  "BulkSMS": {
    "SenderId": "",
    "Api_Key": ""
  },
  // Guards the unauthenticated send-otp endpoint, which spends SMS credits.
  "OtpRateLimit": {
    "Enabled": true,
    "CooldownSeconds": 60,
    "PerPhonePerHour": 5,
    "PerPhonePerDay": 15,
    "PerIpPerHour": 20
  },
  // Origins allowed to call the API from a browser. Empty = permissive (dev only).
  "Cors": {
    "AllowedOrigins": []
  },
  // Bootstrap login that works without a live SMS gateway. Set Enabled=false in production.
  "MasterAuth": {
    "Enabled": true,
    "Phone": "01708521990",
    "Otp": "123456",
    "Name": "Faruk Hannan",
    "AllowOtpForAllPhones": false
  },
    "Sms": {
        "Provider": "sslwireless",
        "ApiKey": "",
        "SenderId": "OneWeb"
    },
  // DigitalOcean Spaces CDN for storefront imagery.
  // Secrets come from the environment — Cdn__AccessKey / Cdn__SecretKey — never
  // from this file. Empty keys simply disable uploads.
  "Cdn": {
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "",
    "Region": "sgp1",
    "Endpoint": "https://sgp1.digitaloceanspaces.com",
    "CdnEndpoint": "",
    "RootFolder": "Onetap"
  },
  // SSL Wireless SMS Plus (v3 JSON API). Leave ApiBase empty to disable SMS in
  // local development — SendOtpCommandHandler then falls back to BulkSMS.
  "SslWireless": {
    "ApiBase": "https://smsplus.sslwireless.com",
    "Sid": "",
    "ApiToken": "",
    "MaskingSenderId": "",
    "MaskingEnabled": false,
    "NonMaskingSender": "",
    "NonMaskingEnabled": false,
    "TimeoutSeconds": 10
  },
  // SSLCommerz hosted checkout. Sandbox URLs by default; swap the base URLs to
  // https://securepay.sslcommerz.com for live. StoreId/StorePassword come from
  // the SSLCommerz merchant panel.
  "SslCommerz": {
    "StoreId": "",
    "StorePassword": "",
    "ApiVersion": "4",
    "ApiBaseUrl": "https://sandbox.sslcommerz.com",
    "ValidationBaseUrl": "https://sandbox.sslcommerz.com",
    "RefundBaseUrl": "https://sandbox.sslcommerz.com",
    "PublicBaseUrl": "http://localhost:5102",
    "FrontendReturnUrl": "http://localhost:3000/profile?tab=bookings",
    "Currency": "BDT",
    "TimeoutSeconds": 30
  },
    "Firebase": {
        "CredentialsPath": "firebase-credentials.json"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
