# =============================================================================
# OneTap Service — production environment
#
# GIT-IGNORED. Real secrets live here and must never be committed.
# The API reads these at startup (see EnvironmentConfiguration.cs, which maps
# these names onto the appsettings sections), so nothing is hardcoded in source.
# =============================================================================

ASPNETCORE_ENVIRONMENT=Production
TZ=Asia/Dhaka

# ========== PUBLIC URLS ==========
# Where the storefront runs, and where this API is reachable from the internet.
# SSLCommerz callbacks and the payment return-URL allow-list derive from these.
FRONTEND_URL=https://onetapservice.com
API_PUBLIC_BASE_URL=https://api.onetapservice.com
PAYMENT_ALLOWED_RETURN_ORIGINS=https://onetapservice.com,https://www.onetapservice.com

# ========== DATABASE ==========
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=oneweb
POSTGRES_USER=oneweb
POSTGRES_PASSWORD=
CONNECTIONSTRINGS__DEFAULT=

# ========== REDIS ==========
REDIS__CONNECTIONSTRING=redis:6379

# ========== JWT ==========
# Must be at least 32 characters. Generate a fresh one per environment.
JWT__SECRETKEY=
JWT__ISSUER=OneWeb
JWT__AUDIENCE=OneWebUsers
JWT__ACCESSTOKENEXPIRYMINUTES=60
JWT__REFRESHTOKENEXPIRYDAYS=7

# ========== BOOTSTRAP LOGIN ==========
# The master phone/OTP bypass. MUST be false in production — when enabled the
# OTP never expires and is never consumed.
MASTERAUTH__ENABLED=false

# ========== SMS NOTIFICATIONS (SSL WIRELESS OTP) ==========

SSLWIRELESS_API_BASE=https://smsplus.sslwireless.com
SSLWIRELESS_SID=
SSLWIRELESS_API_KEY=
SSLWIRELESS_SENDER_ID=

SSLWIRELESS_NONMASKING_SENDER=
SSLWIRELESS_DLR_WEBHOOK_URL=https://api.onetapservice.com/v1/sms/dlr
SSLWIRELESS_MASKING_ENABLED=true
SSLWIRELESS_NONMASKING_ENABLED=false
SSLWIRELESSL_USER=
SSLWIRELESS_PASSWORD=
SSLWIRELESS_MESSAGE_TYPE=EN
DLR_WEBHOOK_URL=https://api.onetapservice.com/v1/sms/dlr

# ========== PAYMENT — SSLCOMMERZ ==========
# OneTap's own live store. Until these are filled in, online payment is
# rejected at initiate rather than silently falling back.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_API_VERSION=4
SSLCOMMERZ_API_BASE_URL=https://securepay.sslcommerz.com
SSLCOMMERZ_VALIDATION_BASE_URL=https://securepay.sslcommerz.com
SSLCOMMERZ_REFUND_BASE_URL=https://securepay.sslcommerz.com
SSLCOMMERZ_CURRENCY=BDT

# ========== CDN — DIGITALOCEAN SPACES ==========
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_BUCKET_NAME=
SPACES_REGION=sgp1
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_CDN_ENDPOINT=
SPACES_ROOT_FOLDER=Onetap

# ========== STOREFRONT (Next.js build-time) ==========
# Baked into the client bundle at build time, so it must be set before
# `next build`. Leave empty to fall back to the page's own origin.
NEXT_PUBLIC_API_URL=https://api.onetapservice.com


# ========== PLACES / GEOCODING PROVIDERS ==========
# Tried in this order; the first that answers wins. Both are optional — without
# them the site falls back to Mapbox, whose Bangladesh street data is sparse.
# Barikoi is Bangladesh-specific and gives by far the best local results.
NEXT_PUBLIC_BARIKOI_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
